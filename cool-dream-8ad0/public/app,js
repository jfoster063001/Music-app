const audio = document.getElementById("audioPlayer");

const songList = document.getElementById("songList");
const songCount = document.getElementById("songCount");
const searchInput = document.getElementById("searchInput");

const loginButton = document.getElementById("loginButton");
const loginModal = document.getElementById("loginModal");
const closeLoginButton =
  document.getElementById("closeLoginButton");

const loginForm =
  document.getElementById("loginForm");

const loginError =
  document.getElementById("loginError");

const uploadSection =
  document.getElementById("uploadSection");

const uploadForm =
  document.getElementById("uploadForm");

const uploadStatus =
  document.getElementById("uploadStatus");

const currentUser =
  document.getElementById("currentUser");

const playButton =
  document.getElementById("playButton");

const previousButton =
  document.getElementById("previousButton");

const nextButton =
  document.getElementById("nextButton");

const progressBar =
  document.getElementById("progressBar");

const currentTime =
  document.getElementById("currentTime");

const duration =
  document.getElementById("duration");

const volumeBar =
  document.getElementById("volumeBar");


let songs = [];

let currentSongIndex = -1;

let currentUserData = null;


/* =========================================================
   API
========================================================= */

async function api(url, options = {}) {

  const response = await fetch(url, {
    credentials: "same-origin",
    ...options
  });

  let data = null;

  try {
    data = await response.json();
  } catch {
    // Response wasn't JSON.
  }

  if (!response.ok) {

    throw new Error(
      data?.error ||
      `Request failed (${response.status})`
    );

  }

  return data;
}


/* =========================================================
   LOAD SONGS
========================================================= */

async function loadSongs() {

  try {

    songs = await api("/api/songs");

    renderSongs();

  } catch (error) {

    songList.innerHTML = `
      <div class="empty-state error">
        Unable to load songs:
        ${escapeHtml(error.message)}
      </div>
    `;

  }

}


/* =========================================================
   RENDER SONGS
========================================================= */

function renderSongs() {

  const query =
    searchInput.value
      .trim()
      .toLowerCase();


  const filteredSongs = query

    ? songs.filter(song =>

        song.title
          .toLowerCase()
          .includes(query)

        ||

        song.artist
          .toLowerCase()
          .includes(query)

        ||

        song.filename
          .toLowerCase()
          .includes(query)

      )

    : songs;


  songCount.textContent =
    `${filteredSongs.length} song${
      filteredSongs.length === 1
        ? ""
        : "s"
    }`;


  if (filteredSongs.length === 0) {

    songList.innerHTML = `
      <div class="empty-state">

        <div class="empty-icon">
          ♫
        </div>

        <h3>
          No songs found
        </h3>

        <p>
          Try another search or upload some music.
        </p>

      </div>
    `;

    return;
  }


  songList.innerHTML = "";


  filteredSongs.forEach(
    (song, index) => {

      const actualIndex =
        songs.findIndex(
          s => s.id === song.id
        );


      const row =
        document.createElement("div");

      row.className = "song-row";


      const isCurrent =
        currentSongIndex === actualIndex;


      row.innerHTML = `

        <div class="song-number">
          ${
            isCurrent
              ? "▶"
              : index + 1
          }
        </div>


        <div class="song-info">

          <strong>
            ${escapeHtml(song.title)}
          </strong>

          <span>
            ${escapeHtml(song.artist)}
          </span>

        </div>


        <div class="song-filename">
          ${escapeHtml(song.filename || "")}
        </div>


        <button
          class="button small">

          ${
            isCurrent &&
            !audio.paused
              ? "Pause"
              : "Play"
          }

        </button>

      `;


      row
        .querySelector("button")
        .addEventListener(
          "click",
          () => {

            if (
              currentSongIndex === actualIndex &&
              !audio.paused
            ) {

              audio.pause();

            } else {

              playSong(actualIndex);

            }

          }
        );


      songList.appendChild(row);

    }
  );

}


/* =========================================================
   PLAY SONG
========================================================= */

function playSong(index) {

  if (!songs[index]) {
    return;
  }


  currentSongIndex = index;


  const song =
    songs[index];


  audio.src =
    `/api/songs/${
      encodeURIComponent(song.id)
    }/stream`;


  document.getElementById(
    "playerTitle"
  ).textContent =
    song.title;


  document.getElementById(
    "playerArtist"
  ).textContent =
    song.artist;


  audio.play()
    .catch(error => {

      console.error(
        "Playback failed:",
        error
      );

    });


  renderSongs();

}


/* =========================================================
   PLAYER
========================================================= */

function formatTime(seconds) {

  if (!Number.isFinite(seconds)) {
    return "0:00";
  }


  const minutes =
    Math.floor(seconds / 60);


  const secondsRemaining =
    Math.floor(seconds % 60)
      .toString()
      .padStart(2, "0");


  return `${minutes}:${secondsRemaining}`;

}


function updatePlayButton() {

  playButton.textContent =
    audio.paused
      ? "▶"
      : "❚❚";

}


function playNext() {

  if (!songs.length) {
    return;
  }


  const nextIndex =
    currentSongIndex <
    songs.length - 1

      ? currentSongIndex + 1

      : 0;


  playSong(nextIndex);

}


function playPrevious() {

  if (!songs.length) {
    return;
  }


  const previousIndex =
    currentSongIndex > 0

      ? currentSongIndex - 1

      : songs.length - 1;


  playSong(previousIndex);

}


playButton.addEventListener(
  "click",
  () => {

    if (currentSongIndex === -1) {

      if (songs.length) {
        playSong(0);
      }

      return;
    }


    if (audio.paused) {
      audio.play();
    } else {
      audio.pause();
    }

  }
);


previousButton.addEventListener(
  "click",
  playPrevious
);


nextButton.addEventListener(
  "click",
  playNext
);


audio.addEventListener(
  "play",
  () => {

    updatePlayButton();
    renderSongs();

  }
);


audio.addEventListener(
  "pause",
  () => {

    updatePlayButton();
    renderSongs();

  }
);


audio.addEventListener(
  "ended",
  playNext
);


audio.addEventListener(
  "loadedmetadata",
  () => {

    duration.textContent =
      formatTime(audio.duration);

  }
);


audio.addEventListener(
  "timeupdate",
  () => {

    currentTime.textContent =
      formatTime(audio.currentTime);


    if (audio.duration) {

      progressBar.value =
        (
          audio.currentTime /
          audio.duration
        ) * 100;

    }

  }
);


progressBar.addEventListener(
  "input",
  () => {

    if (audio.duration) {

      audio.currentTime =
        (
          Number(progressBar.value) /
          100
        ) *
        audio.duration;

    }

  }
);


volumeBar.addEventListener(
  "input",
  () => {

    audio.volume =
      Number(volumeBar.value);

  }
);


/* =========================================================
   AUTHENTICATION
========================================================= */

async function checkAuthentication() {

  try {

    const data =
      await api("/api/auth/me");


    currentUserData =
      data.user;


    loginButton.textContent =
      "Logout";


    uploadSection
      .classList
      .remove("hidden");


    currentUser.textContent =
      `${currentUserData.username} · ${
        currentUserData.role
      }`;

  } catch {

    currentUserData = null;


    loginButton.textContent =
      "Login";


    uploadSection
      .classList
      .add("hidden");


    currentUser.textContent =
      "";

  }

}


function openLoginModal() {

  loginError.textContent =
    "";


  loginForm.reset();


  loginModal
    .classList
    .remove("hidden");


  document
    .getElementById("usernameInput")
    .focus();

}


function closeLoginModal() {

  loginModal
    .classList
    .add("hidden");

}


async function logout() {

  try {

    await api(
      "/api/auth/logout",
      {
        method: "POST"
      }
    );

  } catch (error) {

    console.error(
      "Logout failed:",
      error
    );

  }


  await checkAuthentication();

}


loginButton.addEventListener(
  "click",
  () => {

    if (currentUserData) {

      logout();

    } else {

      openLoginModal();

    }

  }
);


closeLoginButton.addEventListener(
  "click",
  closeLoginModal
);


loginModal
  .querySelector(".modal-backdrop")
  .addEventListener(
    "click",
    closeLoginModal
  );


loginForm.addEventListener(
  "submit",
  async event => {

    event.preventDefault();


    loginError.textContent =
      "";


    const username =
      document.getElementById(
        "usernameInput"
      ).value;


    const password =
      document.getElementById(
        "passwordInput"
      ).value;


    try {

      await api(
        "/api/auth/login",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body:
            JSON.stringify({
              username,
              password
            })
        }
      );


      closeLoginModal();


      await checkAuthentication();

    } catch (error) {

      loginError.textContent =
        error.message ||
        "Login failed.";

    }

  }
);


/* =========================================================
   UPLOAD
========================================================= */

uploadForm.addEventListener(
  "submit",
  async event => {

    event.preventDefault();


    uploadStatus.textContent =
      "Uploading...";


    const file =
      document.getElementById(
        "fileInput"
      ).files[0];


    if (!file) {

      uploadStatus.textContent =
        "Choose an audio file.";

      return;

    }


    /*
     * The Cloudflare Workers Free plan
     * currently has a request-body limit,
     * so keep uploads below 100 MB for now.
     */

    if (
      file.size >
      100 * 1024 * 1024
    ) {

      uploadStatus.textContent =
        "File must be smaller than 100 MB.";

      return;

    }


    const formData =
      new FormData();


    formData.append(
      "file",
      file
    );


    formData.append(
      "title",
      document.getElementById(
        "titleInput"
      ).value
    );


    formData.append(
      "artist",
      document.getElementById(
        "artistInput"
      ).value
    );


    try {

      await api(
        "/api/songs/upload",
        {
          method: "POST",
          body: formData
        }
      );


      uploadForm.reset();


      uploadStatus.textContent =
        "Upload successful.";


      await loadSongs();


    } catch (error) {

      uploadStatus.textContent =
        `Upload failed: ${
          error.message
        }`;

    }

  }
);


/* =========================================================
   SEARCH
========================================================= */

searchInput.addEventListener(
  "input",
  renderSongs
);


/* =========================================================
   HTML ESCAPING
========================================================= */

function escapeHtml(value) {

  return String(value ?? "")

    .replaceAll(
      "&",
      "&amp;"
    )

    .replaceAll(
      "<",
      "&lt;"
    )

    .replaceAll(
      ">",
      "&gt;"
    )

    .replaceAll(
      '"',
      "&quot;"
    )

    .replaceAll(
      "'",
      "&#039;"
    );

}


/* =========================================================
   INITIALIZE
========================================================= */

(async function init() {

  await checkAuthentication();

  await loadSongs();

})();