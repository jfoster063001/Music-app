{
  "name": "music-app",

  "main": "src/index.js",

  "compatibility_date": "2026-09-07",

  "r2_buckets": [
    {
      "binding": "MUSIC_BUCKET",
      "bucket_name": "music-files"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-db",
      "database_id": "YOUR_DATABASE_ID"
    }
  ]
}